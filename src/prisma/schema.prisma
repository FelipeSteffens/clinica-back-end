generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:senai@localhost:5432/clinic?schema=public"
}

model Usuario {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  nome   String?
  senha  String
  tokens Token[]

  @@map("usuario")
}

model Exame {
  id         Int      @id @default(autoincrement())
  tipo_exame String
  valor      Decimal
  descricao  String
  resultado  String
  data_exame DateTime

  @@map("exame")
}

enum Role {
  Login
  Refresh
}

model Token {
  id         Int      @id @default(autoincrement())
  token      String
  tipo_token Role     @default(Login)
  revogado   Boolean  @default(false)
  expirado   DateTime
  usuarioId  Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}
